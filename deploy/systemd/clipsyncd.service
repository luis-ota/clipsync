[Unit]
Description=clipsync TLS relay
Documentation=https://github.com/luis-ota/clipsync/tree/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=clipsync
ConfigurationDirectory=clipsync
ExecStart=clipsync-relay --config %E/clipsync/config.toml
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=clipsync_core=info,clipsync_relay=info
EnvironmentFile=-%E/clipsync/relay.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
