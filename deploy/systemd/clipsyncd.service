[Unit]
Description=clipsyncd headless relay
Documentation=https://github.com/luis-ota/clipsync/tree/develop/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipsync
Group=clipsync
ExecStart=/usr/local/bin/clipsyncd run --no-tray --config /etc/clipsync/config.toml
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=clipsync_core=info,clipsyncd=info
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clipsync
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
