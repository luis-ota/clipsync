CLIPSYNC_NAME=clipsync-relay
CLIPSYNC_PORT=8765
CLIPSYNC_BIND=0.0.0.0:8765
CLIPSYNC_SECURITY_TRANSPORT=tls
CLIPSYNC_LIMITS_MAX_CONNECTIONS=256
CLIPSYNC_LIMITS_MESSAGES_PER_MINUTE=120
CLIPSYNC_LIMITS_BYTES_PER_MINUTE=67108864
# Arquivo local criado por deploy/generate-relay-credentials.sh (modo 0600).
CLIPSYNC_RELAY_TOKEN_FILE=./relay.tokens
# Provisionamento E2E por endpoint: key_id group_id hex(32 bytes), modo 0600.
CLIPSYNC_E2E_KEY_FILE=./relay-group.key
